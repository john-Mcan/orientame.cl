---
import Breadcrumbs from '@components/Breadcrumbs.astro';
import Card from '@components/Card.astro';
import PageIntro from '@components/PageIntro.astro';
import Base from '@layouts/Base.astro';
---

<Base
  title="Información legal"
  description="Privacidad, alcance y términos de uso de orientame.cl."
>
  <div class="reading-shell">
    <Breadcrumbs items={[{ label: 'Inicio', href: '/' }, { label: 'Información legal' }]} />
  </div>
  <PageIntro
    eyebrow="Información legal"
    title="Reglas y límites en lenguaje claro"
    description="Estos documentos describen cómo funciona el sitio, qué datos implica navegarlo y qué no puede hacer por ti."
  />
  <section class="legal-grid reading-shell" aria-label="Documentos legales">
    <Card title="Privacidad" href="/legal/privacidad">
      <p>Datos técnicos, herramientas locales, terceros y decisiones de privacidad de la v1.</p>
    </Card>
    <Card title="Alcance y límites" href="/legal/alcance">
      <p>Qué ofrece orientame.cl y qué tareas clínicas, de emergencia o comerciales no realiza.</p>
    </Card>
    <Card title="Términos de uso" href="/legal/terminos">
      <p>Condiciones para usar contenido y enlaces externos durante esta etapa de preview.</p>
    </Card>
  </section>
</Base>

<style>
  .legal-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: var(--space-4);
    padding-bottom: var(--space-24);
  }

  @media (max-width: 46rem) {
    .legal-grid {
      grid-template-columns: 1fr;
      padding-bottom: var(--space-16);
    }
  }
</style>
