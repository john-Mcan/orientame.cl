---
import Base from '@layouts/Base.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import Card from '@components/Card.astro';
import EncabezadoSeccion from '@components/EncabezadoSeccion.astro';
import Notice from '@components/Notice.astro';
import { getCollection } from 'astro:content';
import { visibleEnEntorno } from '@/lib/editorial';

const todosLosTemas = await getCollection('temas');
const temasPublicables = todosLosTemas
  .filter((entry) => visibleEnEntorno(entry.data))
  .sort((a, b) => a.data.titulo.localeCompare(b.data.titulo, 'es'));
---

<Base
  title="Temas de salud mental | orientame.cl"
  description="Explicaciones en lenguaje claro sobre cuadros de salud mental como depresión, insomnio, ansiedad o estrés crónico, con la fuente y la fecha de cada afirmación."
>
  <div class="reading-shell">
    <Breadcrumbs items={[{ label: 'Inicio', href: '/' }, { label: 'Temas' }]} />

    <EncabezadoSeccion
      eyebrow="Conceptos clínicos"
      titulo="Temas de salud mental explicados en simple"
      descripcion="Qué significa cada concepto, qué se sabe sobre cómo se aborda y cómo se accede a esa atención en Chile. Cada afirmación indica de dónde sale y cuándo la comprobamos."
      descripcionMovil="Qué significa cada concepto y cómo se accede a esa atención en Chile, con la fuente de cada dato."
    />

    <div class="aviso-alcance">
      <Notice title="Orientación, no diagnóstico">
        <p>
          Conocer cómo se definen estos cuadros permite entender mejor lo que ocurre y consultar con
          más claridad, pero no sustituye una evaluación clínica individual.
        </p>
      </Notice>
    </div>
  </div>

  {
    temasPublicables.length > 0 ? (
      <section class="grilla-temas reading-shell" aria-label="Listado de temas de salud mental">
        {temasPublicables.map((tema) => (
          <Card title={tema.data.titulo} href={`/temas/${tema.id}`}>
            <p>{tema.data.descripcion}</p>
          </Card>
        ))}
      </section>
    ) : (
      <div class="seccion-vacia reading-shell">
        <Notice title="Todavía no hay temas publicados">
          <p>
            Estas páginas están escritas pero aún no superan nuestra verificación de fuentes, así
            que preferimos no publicarlas antes de poder mostrarte de dónde sale cada afirmación.
            Puedes revisar cómo verificamos en <a href="/metodologia">metodología</a>.
          </p>
          <p>
            Mientras tanto, el <a href="/empezar">orientador de primer paso</a> y{' '}
            <a href="/donde">dónde consultar</a> están disponibles.
          </p>
        </Notice>
      </div>
    )
  }

  <section class="seccion-ayuda-adicional reading-shell">
    <h2>¿Prefieres buscar por lo que estás sintiendo hoy?</h2>
    <p>
      Si aún no tienes claro a qué cuadro puede corresponder tu malestar, puedes explorar las
      páginas de experiencias cotidianas en <a href="/siento">lo que sientes</a> o consultar el
      <a href="/empezar">orientador de primer paso</a>.
    </p>
  </section>
</Base>

<style>
  .aviso-alcance {
    margin-bottom: var(--space-8);
  }

  .seccion-vacia {
    margin-bottom: var(--space-12);
  }

  .grilla-temas {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: var(--space-6);
    margin-bottom: var(--space-12);
  }

  .seccion-ayuda-adicional {
    margin-block: var(--space-8) var(--space-16);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-line);
  }

  .seccion-ayuda-adicional h2 {
    font-size: var(--text-xl);
    color: var(--color-ink-900);
    margin: 0 0 var(--space-3);
  }

  .seccion-ayuda-adicional p {
    font-size: var(--text-base);
    color: var(--color-ink-600);
    line-height: 1.6;
    margin: 0;
  }
</style>
