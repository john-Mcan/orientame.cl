---
import Card from '@components/Card.astro';
import Icon from '@components/Icon.astro';
import Notice from '@components/Notice.astro';
import PasoOrientador from '@components/PasoOrientador.astro';
import Buscador from '@components/islands/Buscador';
import Base from '@layouts/Base.astro';
import { SECCIONES } from '@/data/navegacion';
import { getNodo } from '@/lib/orientador';

// La portada y `/empezar` muestran exactamente las mismas puertas de entrada porque leen
// el mismo nodo del orientador. No hay una lista paralela que pueda quedar desactualizada.
const inicio = getNodo('inicio');

if (!inicio || inicio.tipo !== 'paso') {
  throw new Error('La portada necesita el paso "inicio" del orientador.');
}

// El mapa de secciones sale del mismo modelo que el menú: si mañana se publica una sección
// nueva aparece en los dos sitios a la vez.
//
// Quedan fuera dos tarjetas que antes estaban acá. «Buscar» era la tercera vía de búsqueda de
// la misma página —la lupa del encabezado, la caja del hero y la tarjeta—, y «El proyecto»
// está desarrollado como sección completa inmediatamente debajo de esta grilla.
const tarjetasPortada = SECCIONES.filter((seccion) => seccion.id !== 'proyecto').map((seccion) => ({
  href: seccion.href,
  icono: seccion.icono,
  titulo: seccion.etiqueta,
  descripcion: seccion.descripcion,
  descripcionMovil: seccion.descripcionMovil,
}));

// Atajos del hero: lo que el sitio ofrece, a la vista en la primera pantalla. Antes había que
// bajar 2,1 pantallas en móvil para enterarse de que existían. Salen del mismo modelo de
// navegación; `Autoevaluaciones` cuelga de «Empezar» y sólo aporta acá su icono.
const seccionPorId = (id: string) => SECCIONES.find((seccion) => seccion.id === id);
const autoevaluacion = seccionPorId('empezar')?.enlaces.find(
  (enlace) => enlace.href === '/autoevaluacion',
);

const atajos = [
  { href: seccionPorId('donde')?.href, etiqueta: 'Dónde consultar', icono: 'mapa' as const },
  {
    href: seccionPorId('primera-vez')?.href,
    etiqueta: 'Primera vez',
    icono: 'calendario' as const,
  },
  { href: autoevaluacion?.href, etiqueta: autoevaluacion?.etiqueta, icono: 'lista-check' as const },
  {
    href: seccionPorId('acompanar')?.href,
    etiqueta: 'Acompañar a alguien',
    icono: 'personas' as const,
  },
].filter((atajo): atajo is { href: string; etiqueta: string; icono: typeof atajo.icono } =>
  Boolean(atajo.href && atajo.etiqueta),
);
---

<Base
  title="orientame.cl"
  description="Orientación independiente y sin fines de lucro para entender tus opciones de salud mental en Chile y encontrar un siguiente paso posible."
>
  <section class="portada page-shell">
    <div class="portada-inner">
      <div class="portada-copia">
        <h1>No tienes que saber qué te pasa para empezar.</h1>

        <p class="lede texto-amplio">
          Te ayudamos a entender qué opciones existen en Chile y a encontrar un siguiente paso
          posible, si decides darlo. No damos diagnósticos ni reemplazamos a un profesional.
        </p>
        <p class="lede texto-movil">
          Qué opciones de salud mental existen en Chile y cómo se accede a ellas. Sin diagnósticos.
        </p>

        <div class="portada-buscador">
          <Buscador compacto client:load />
        </div>

        {
          /* La línea «Proyecto sin fines de lucro…» salió de acá: costaba unos 90 px de la
            primera pantalla y está desarrollada completa en el bloque «Qué es orientame.cl»,
            más abajo. En su lugar va lo que el sitio ofrece. */
        }
        <nav class="portada-atajos" aria-label="Secciones principales">
          <ul>
            {
              atajos.map((atajo) => (
                <li>
                  <a href={atajo.href}>
                    <Icon name={atajo.icono} size={18} />
                    <span>{atajo.etiqueta}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>

      <div class="portada-entrada">
        <PasoOrientador paso={inicio} nivel="h2" compacto />
        <p class="portada-entrada-pie">
          <a href="/empezar">
            <span>Ir al orientador y ver cada opción explicada</span>
            <Icon name="flecha-derecha" size={16} />
          </a>
        </p>
      </div>
    </div>
  </section>

  <section class="secciones page-shell" aria-labelledby="secciones-titulo">
    <div class="secciones-encabezado">
      <p class="eyebrow">Secciones del sitio</p>
      <h2 id="secciones-titulo">Todo lo que puedes encontrar aquí</h2>
    </div>

    <ul class="secciones-lista">
      {
        tarjetasPortada.map((tarjeta) => (
          <li>
            <a class="tarjeta-seccion" href={tarjeta.href}>
              <span class="tarjeta-icono">
                <Icon name={tarjeta.icono} size={22} />
              </span>
              <span class="tarjeta-titulo">{tarjeta.titulo}</span>
              <span class="tarjeta-texto texto-amplio">{tarjeta.descripcion}</span>
              <span class="tarjeta-texto texto-movil">{tarjeta.descripcionMovil}</span>
              {/* La lista de sub-enlaces en gris claro salió de acá: era casi ilegible y
                  repetía el mega-menú. Lo que valía la pena de esa lista —autoevaluaciones—
                  subió al hero como atajo. */}
              <span class="tarjeta-ir">
                <span>Ver sección</span>
                <Icon name="flecha-derecha" size={16} />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="proyecto page-shell" aria-labelledby="proyecto-titulo">
    <div class="proyecto-encabezado">
      <p class="eyebrow">Qué es orientame.cl</p>
      <h2 id="proyecto-titulo">Un sitio de orientación, no un servicio clínico</h2>
    </div>
    <div class="proyecto-tarjetas">
      <Card title="Sin cuentas ni registro" href="/legal/privacidad">
        <p>
          No necesitas identificarte. Lo que eliges dentro de nuestras herramientas no se almacena
          en los servidores de orientame.cl.
        </p>
      </Card>
      <Card title="Cada dato con su fuente" href="/metodologia">
        <p>
          Las afirmaciones sobre el sistema de salud citan la fuente oficial y la fecha en que la
          consultamos, para que puedas comprobarlas.
        </p>
      </Card>
      <Card title="La red pública primero" href="/sobre">
        <p>
          Las alternativas gratuitas y de bajo costo son la ruta principal. No recibimos pagos ni
          comisiones por derivar a nadie.
        </p>
      </Card>
    </div>
  </section>

  <section class="alcance reading-shell">
    <Notice title="Este sitio no es un servicio de emergencia">
      <p>
        No monitoreamos esta página ni respondemos mensajes. Si tú o alguien cercano corre peligro
        ahora, en <a href="/urgencia">ayuda inmediata</a> están los canales oficiales disponibles en Chile,
        con sus horarios y su costo.
      </p>
    </Notice>
  </section>
</Base>

<style>
  /* Portada: el mensaje, la búsqueda y las puertas de entrada comparten la primera pantalla.
     El bloque es una tarjeta del ancho del contenido sobre fondo blanco, igual que la barra
     de navegación: lo de color son las secciones, no la página entera. */

  .portada {
    padding: clamp(var(--space-8), 5vw, var(--space-24)) clamp(var(--space-4), 3vw, var(--space-16));
    border-radius: var(--radius-lg);
    background: var(--color-mist-100);
  }

  /* `start` y no `center`. La columna de las puertas es más alta que la del mensaje, así que
     centrar parecía la forma de repartir la diferencia: deja unos 450 px de fondo vacío
     ENCIMA del título y empuja los atajos fuera de la primera pantalla. El vacío bajo el
     texto es preferible, porque abajo es sólo fondo y arriba es la primera impresión. */
  .portada-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    align-items: start;
    gap: clamp(var(--space-8), 6vw, var(--space-24));
  }

  .portada-copia {
    max-width: 34rem;
  }

  .portada-copia .lede {
    margin-top: var(--space-6);
  }

  /* La búsqueda entra en la primera pantalla porque es la vía directa para quien ya sabe
     qué palabra tiene en la cabeza. El island se estiliza en `global.css`. */
  .portada-buscador {
    margin-top: var(--space-8);
  }

  /* Lo que el sitio ofrece, en la primera pantalla y en los dos anchos. En escritorio además
     ocupa el hueco que dejaba la columna izquierda: terminaba a un tercio de la altura del
     bloque mientras la columna de las puertas se desbordaba. */
  .portada-atajos {
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-line);
  }

  .portada-atajos ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .portada-atajos a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: var(--space-2);
    padding-inline: var(--space-4);
    border: 1px solid var(--color-sage-400);
    border-radius: 999px;
    color: var(--color-green-900);
    font-size: var(--text-sm);
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
    background: var(--color-white);
  }

  .portada-atajos a:hover {
    border-color: var(--color-green-700);
    background: var(--color-mist-50);
  }

  .portada-atajos svg {
    color: var(--color-green-700);
  }

  /* En la portada el título es el foco principal, así que la pregunta del orientador
     entra un escalón por debajo del `h1`. */
  .portada-entrada {
    padding: var(--space-6);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: var(--color-paper);
  }

  .portada-entrada :global(.paso-pregunta) {
    font-size: var(--text-lg);
  }

  .portada-entrada :global(.paso-opciones) {
    margin-top: var(--space-6);
  }

  /* La portada muestra las puertas sin su detalle para que las ocho quepan en la primera
     pantalla; este enlace lleva a la versión explicada, en `/empezar`. */
  .portada-entrada-pie {
    margin-top: var(--space-4);
  }

  .portada-entrada-pie a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  /* Mapa de secciones: qué existe en el sitio, en una sola vista. */

  .secciones {
    padding-block: var(--space-16) 0;
  }

  .secciones-encabezado .eyebrow + h2 {
    margin-top: var(--space-2);
  }

  /* Columnas explícitas: con `auto-fit` las seis tarjetas caían en filas de cuatro y dos,
     y la última fila quedaba estirada. */
  .secciones-lista {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    padding: 0;
    margin-top: var(--space-8);
    list-style: none;
  }

  @media (min-width: 38rem) {
    .secciones-lista {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Cuatro secciones en cuatro columnas: con tres quedaba una tarjeta sola en la segunda
     fila, que se lee como un hueco y no como una grilla. */
  @media (min-width: 64rem) {
    .secciones-lista {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* Columna flexible para que el "Ver sección" quede al pie de todas las tarjetas de una
     fila, aunque la bajada de cada una tenga distinto largo. */
  .tarjeta-seccion {
    display: flex;
    height: 100%;
    flex-direction: column;
    align-items: start;
    gap: var(--space-2);
    padding: var(--space-6);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-white);
    text-decoration: none;
  }

  .tarjeta-icono {
    display: inline-flex;
    width: 2.75rem;
    height: 2.75rem;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-2);
    border-radius: var(--radius-md);
    color: var(--color-green-700);
    background: var(--color-mist-100);
  }

  .tarjeta-titulo {
    color: var(--color-green-900);
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .tarjeta-texto {
    color: var(--color-ink-600);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  /* Indicador explícito de destino: la tarjeta completa es un enlace y tiene que decirlo. */
  .tarjeta-ir {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: auto;
    padding-top: var(--space-4);
    color: var(--color-green-700);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .tarjeta-seccion:hover {
    border-color: var(--color-sage-400);
    background: var(--color-mist-50);
    transform: translateY(-1px);
  }

  .tarjeta-seccion:hover .tarjeta-titulo {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .tarjeta-seccion:hover .tarjeta-ir :global(svg) {
    transform: translateX(0.2rem);
  }

  /* Qué es orientame.cl */

  /* Segunda banda de color, más clara que la portada: marca el cierre sin competir con ella. */
  .proyecto {
    margin-block: var(--space-16);
    padding: clamp(var(--space-12), 4vw, var(--space-16))
      clamp(var(--space-4), 3vw, var(--space-12));
    border-radius: var(--radius-lg);
    background: var(--color-mist-50);
  }

  .proyecto-encabezado {
    max-width: 42rem;
  }

  .proyecto-encabezado .eyebrow + h2 {
    margin-top: var(--space-2);
  }

  .proyecto-tarjetas {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-12);
  }

  .alcance {
    padding-bottom: var(--space-24);
  }

  @media (prefers-reduced-motion: no-preference) {
    .tarjeta-seccion,
    .tarjeta-ir :global(svg) {
      transition:
        border-color 150ms ease,
        background-color 150ms ease,
        transform 150ms ease;
    }
  }

  @media (max-width: 64rem) {
    .portada-inner {
      grid-template-columns: 1fr;
      gap: var(--space-12);
    }

    .portada-copia {
      max-width: 40rem;
    }
  }

  @media (max-width: 48rem) {
    .portada-copia .lede {
      margin-top: var(--space-4);
    }

    .portada-buscador,
    .portada-atajos {
      margin-top: var(--space-6);
    }

    .portada-atajos {
      padding-top: var(--space-4);
    }

    /* El título ocupaba tres líneas a 40 px y empujaba todo lo accionable fuera de la primera
       pantalla: a 390 px la única acción visible era el botón de buscar. Se baja el piso del
       `clamp` de `--text-2xl` sólo acá; el techo lo sigue fijando el token. */
    .portada h1 {
      font-size: clamp(2rem, 8vw, 2.5rem);
    }

    .portada-entrada {
      padding: var(--space-4);
    }

    .secciones {
      padding-block: var(--space-12) 0;
    }

    /* Radio menor en pantallas angostas: una esquina de 1,25 rem sobre una tarjeta que ocupa
       casi todo el ancho se lee como deformación, no como tarjeta. */
    .portada,
    .proyecto {
      border-radius: var(--radius-md);
    }

    .proyecto {
      margin-block: var(--space-12);
    }

    .proyecto-tarjetas {
      grid-template-columns: 1fr;
    }

    .alcance {
      padding-bottom: var(--space-16);
    }
  }
</style>
