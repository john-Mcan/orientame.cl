---
import Base from '@layouts/Base.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import EncabezadoSeccion from '@components/EncabezadoSeccion.astro';
import Notice from '@components/Notice.astro';
import FichaRecurso from '@components/FichaRecurso.astro';
import BloqueSiguientePaso from '@components/BloqueSiguientePaso.astro';
import { getRecursosClinicasUniversitarias } from '@/lib/resources';

const clinicas = getRecursosClinicasUniversitarias();
---

<Base
  title="Clínicas psicológicas universitarias en Chile"
  description="Cómo funcionan las clínicas psicológicas universitarias en Chile, qué preguntar antes de contar con ellas y cuáles hemos podido comprobar."
>
  <div class="reading-shell" data-pagefind-body data-pagefind-filter="seccion:Dónde consultar">
    <Breadcrumbs
      items={[
        { label: 'Inicio', href: '/' },
        { label: 'Dónde consultar', href: '/donde' },
        { label: 'Clínicas universitarias' },
      ]}
    />

    <EncabezadoSeccion
      indexable
      eyebrow="Alternativa accesible"
      titulo="Clínicas psicológicas universitarias a bajo costo"
      descripcion="Varias facultades de psicología atienden público general en sus centros docentes. Suelen ser una vía más barata que la consulta privada, pero cada una fija sus propias condiciones, así que conviene preguntarlas antes de contar con ellas."
      descripcionMovil="Varias facultades de psicología atienden público general. Cada una fija sus condiciones, así que conviene preguntarlas antes."
    />

    <div class="aviso-formato">
      <Notice title="¿Cómo funciona la atención universitaria?">
        <p>
          Son centros docentes: la atención la realizan estudiantes de psicología en práctica
          clínica, con supervisión de académicos de la facultad. Cómo se organiza esa supervisión
          varía entre universidades y es una pregunta razonable de hacer al momento de consultar.
        </p>
      </Notice>
    </div>

    <section class="seccion-explicacion">
      <h2>Qué conviene preguntar antes de contar con esta vía</h2>
      <p>
        No publicamos aranceles ni fechas de admisión porque cada centro fija los suyos y cambian.
        Estas son las tres preguntas que resuelven casi todo en una sola llamada:
      </p>
      <ul>
        <li><strong>¿Cuánto cuesta la sesión</strong> y si el valor depende de tus ingresos?</li>
        <li><strong>¿Hay cupos ahora</strong> o la admisión se abre en fechas determinadas?</li>
        <li><strong>¿Atienden a personas de cualquier comuna</strong> y en qué modalidad?</li>
      </ul>
    </section>

    <section class="seccion-recursos" aria-labelledby="clinicas-titulo">
      <h2 id="clinicas-titulo" class="seccion-subtitulo">
        Clínicas que hemos comprobado ({clinicas.length})
      </h2>

      <div class="lista-fichas">
        {clinicas.map((clinica) => <FichaRecurso recurso={clinica} />)}
      </div>
    </section>

    <BloqueSiguientePaso
      titulo="¿Quieres explorar otras opciones en tu comuna?"
      descripcion="Revisa la red pública de salud primaria o las líneas gratuitas de apoyo."
      accionPrincipal={{
        texto: 'Ver directorio general',
        href: '/donde',
        tipo: 'recorrido',
        aclaracion: 'Líneas nacionales y cómo se accede por comuna.',
      }}
      pasoMenorCompromiso={{
        texto: 'Guía de costos en salud mental',
        href: '/primera-vez/cuanto-cuesta',
        descripcion: 'Qué cuesta cada vía: pública, universitaria y privada.',
      }}
    />
  </div>
</Base>

<style>
  .aviso-formato {
    margin-bottom: var(--space-8);
  }

  .seccion-explicacion {
    margin-block: var(--space-6) var(--space-8);
  }

  .seccion-explicacion h2 {
    font-size: var(--text-xl);
    color: var(--color-ink-900);
    margin: 0 0 var(--space-4);
  }

  .seccion-explicacion ul {
    margin: 0;
    padding-left: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    font-size: var(--text-base);
    color: var(--color-ink-900);
    line-height: 1.6;
  }

  .seccion-recursos {
    margin-block: var(--space-6) var(--space-12);
  }

  .seccion-subtitulo {
    font-size: var(--text-xl);
    color: var(--color-ink-900);
    margin: 0 0 var(--space-6);
  }

  .lista-fichas {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
</style>
