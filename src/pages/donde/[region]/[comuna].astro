---
import Base from '@layouts/Base.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import Notice from '@components/Notice.astro';
import FichaRecurso from '@components/FichaRecurso.astro';
import BloqueSiguientePaso from '@components/BloqueSiguientePaso.astro';
import SourceList from '@components/SourceList.astro';
import { COMUNAS_PILOTO, getRecursosPorComuna, type ComunaPiloto } from '@/lib/resources';
import { resolverFuentes } from '@/data/fuentes';

const fuentesAcceso = resolverFuentes(['chileatiende-atencion-fonasa']).map((f) => ({
  name: `${f.titulo} (${f.organizacion})`,
  url: f.url,
  note: `consultada el ${f.consultadoEl}`,
}));

export function getStaticPaths() {
  return COMUNAS_PILOTO.map((c) => ({
    params: { region: c.regionSlug, comuna: c.slug },
    props: { comunaInfo: c },
  }));
}

interface Props {
  comunaInfo: ComunaPiloto;
}

const { comunaInfo } = Astro.props;
const recursosComuna = getRecursosPorComuna(comunaInfo.regionSlug, comunaInfo.slug);
---

<Base
  title={`Salud mental en ${comunaInfo.nombre} | orientame.cl`}
  description={`Cómo se accede a la atención de salud mental pública si vives o trabajas en ${comunaInfo.nombre} (${comunaInfo.region}): por dónde se entra, qué cubre Fonasa y a quién preguntar.`}
>
  <div class="reading-shell">
    <Breadcrumbs
      items={[
        { label: 'Inicio', href: '/' },
        { label: 'Dónde consultar', href: '/donde' },
        { label: comunaInfo.nombre },
      ]}
    />

    <header class="seccion-encabezado">
      <p class="eyebrow">Red de salud comunal</p>
      <h1>Salud mental en {comunaInfo.nombre}</h1>
      <p class="lede">
        {comunaInfo.descripcion} Aquí explicamos por dónde se entra a la atención de salud mental si vives
        o trabajas en la comuna, y qué hemos podido confirmar hasta ahora.
      </p>
    </header>

    <div class="aviso-inscripcion">
      <Notice title="Cómo funciona la atención pública en la comuna">
        <p>
          La puerta de entrada a la red pública es el centro de Atención Primaria donde estás
          inscrito, que corresponde a tu domicilio o a tu lugar de trabajo. La consulta o control
          con psicólogo clínico en ese nivel tiene 100% de cobertura para todos los tramos de
          Fonasa.
        </p>
        <p>
          Para saber qué centro te corresponde, su dirección y sus horarios, puedes llamar a Salud
          Responde al <a href="tel:+566003607777" data-siguiente-paso="llamada">600 360 7777</a>,
          que atiende las 24 horas.
        </p>
      </Notice>
      <div class="fuentes-aviso">
        <SourceList sources={fuentesAcceso} />
      </div>
    </div>

    <section class="seccion-recursos" aria-labelledby="recursos-titulo">
      <h2 id="recursos-titulo" class="seccion-subtitulo">
        Centros y recursos en {comunaInfo.nombre}
      </h2>

      {
        recursosComuna.length > 0 ? (
          <div class="lista-fichas">
            {recursosComuna.map((recurso) => (
              <FichaRecurso recurso={recurso} />
            ))}
          </div>
        ) : (
          <Notice title="Todavía no publicamos fichas de centros en esta comuna">
            <p>
              Una ficha nuestra sólo se publica cuando alguien confirmó, uno por uno, la dirección,
              el teléfono y los pasos reales para conseguir hora. Para {comunaInfo.nombre} eso
              todavía no está hecho, y preferimos no listar datos que no hemos comprobado: una
              dirección equivocada te hace perder un viaje.
            </p>
            <p>
              Mientras tanto, el camino que sí podemos respaldar es el de arriba: llamar a Salud
              Responde para que te indiquen el centro que te corresponde.
            </p>
          </Notice>
        )
      }
    </section>

    <BloqueSiguientePaso
      titulo="¿No sabes qué decir al acudir al centro?"
      descripcion="Hay mensajes ya escritos que puedes copiar y adaptar para pedir hora en el mesón o por teléfono."
      accionPrincipal={{
        texto: 'Ver guiones para pedir hora',
        href: '/primera-vez/que-decir',
        tipo: 'guion',
        aclaracion: 'Mensajes preparados para mesón de CESFAM y solicitudes de salud mental.',
      }}
      pasoMenorCompromiso={{
        texto: 'Ver directorio general de comunas',
        href: '/donde',
        descripcion: 'Líneas nacionales, clínicas universitarias y otras comunas.',
      }}
    />
  </div>
</Base>

<style>
  .seccion-encabezado {
    margin-block: var(--space-8) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .eyebrow {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-green-700);
    margin: 0;
  }

  h1 {
    line-height: 1.2;
    color: var(--color-ink-900);
    margin: 0;
  }

  .lede {
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--color-ink-600);
    margin: 0;
  }

  .aviso-inscripcion {
    margin-bottom: var(--space-8);
  }

  .fuentes-aviso {
    margin-top: var(--space-4);
  }

  .seccion-recursos {
    margin-block: var(--space-6) var(--space-12);
  }

  .seccion-subtitulo {
    font-size: var(--text-xl);
    color: var(--color-ink-900);
    margin: 0 0 var(--space-6);
  }

  .lista-fichas {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
</style>
