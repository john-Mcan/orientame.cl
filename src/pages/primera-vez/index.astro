---
import Base from '@layouts/Base.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import Card from '@components/Card.astro';
import EncabezadoSeccion from '@components/EncabezadoSeccion.astro';
import Notice from '@components/Notice.astro';
import BloqueSiguientePaso from '@components/BloqueSiguientePaso.astro';
---

<Base
  title="Primera vez buscando apoyo psicológico"
  description="Qué ocurre en una primera consulta, cuánto cuesta en Chile, qué decir al pedir hora y cómo elegir profesional."
>
  <div class="reading-shell">
    <Breadcrumbs items={[{ label: 'Inicio', href: '/' }, { label: 'Primera vez' }]} />

    {
      /* Sin bajada acortada en móvil a propósito: nombrar las tres dudas concretas es lo que
        hace que la persona se reconozca en la sección. */
    }
    <EncabezadoSeccion
      eyebrow="Guía de inicio"
      titulo="Antes de tu primera consulta"
      descripcion="Consultar por primera vez deja varias dudas abiertas: cuánto va a costar, qué preguntan, cuánto dura, cómo explicar lo que te pasa. Acá está lo que se puede resolver leyendo, para que decidas con la información en la mano y a tu ritmo."
    />

    <div class="aviso-tranquilidad">
      <Notice title="No tienes que llegar con todo resuelto">
        <p>
          Es fácil postergar la consulta pensando que primero hay que ordenar la historia o saber
          exactamente qué te ocurre. Ordenar lo que sientes es parte de lo que se hace en la
          consulta, no un requisito para llegar a una.
        </p>
      </Notice>
    </div>

    <section class="seccion-guias" aria-labelledby="guias-titulo">
      <h2 id="guias-titulo" class="sr-only">Guías de primera vez</h2>
      <div class="grilla-guias">
        <Card title="¿Qué pasa en una primera sesión?" href="/primera-vez/que-pasa-en-sesion">
          <p>
            Cuánto dura, qué suelen preguntar, cómo funciona el secreto profesional y qué pasa si te
            emocionas o te quedas en silencio.
          </p>
        </Card>

        <Card title="Guiones: qué decir para pedir hora" href="/primera-vez/que-decir">
          <p>
            Mensajes listos para copiar y adaptar al contactar un CESFAM, una clínica privada o al
            hablar con alguien cercano.
          </p>
        </Card>

        <Card title="¿Cuánto cuesta la atención en Chile?" href="/primera-vez/cuanto-cuesta">
          <p>
            La vía pública, las garantías AUGE-GES, las clínicas universitarias y la atención
            privada, con qué preguntar en cada una.
          </p>
        </Card>

        <Card title="Cómo elegir profesional" href="/primera-vez/como-elegir">
          <p>
            Diferencias entre psicología y psiquiatría, cómo verificar el registro oficial de
            prestadores y corrientes terapéuticas explicadas en simple.
          </p>
        </Card>
      </div>
    </section>

    <BloqueSiguientePaso
      titulo="¿Dónde se pide la hora?"
      descripcion="Establecimientos vigentes por comuna, clínicas universitarias y líneas nacionales, con lo que hemos podido comprobar de cada uno."
      accionPrincipal={{
        texto: 'Ver dónde consultar en Chile',
        href: '/donde',
        tipo: 'recorrido',
        aclaracion: 'Por comuna, tipo de centro y modalidad de costo.',
      }}
      pasoMenorCompromiso={{
        texto: 'Dejar el mensaje escrito antes de llamar',
        href: '/primera-vez/que-decir',
        descripcion: 'Guiones para copiar y adaptar, para no tener que improvisar.',
      }}
    />
  </div>
</Base>

<style>
  .aviso-tranquilidad {
    margin-bottom: var(--space-8);
  }

  .grilla-guias {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: var(--space-6);
    margin-bottom: var(--space-12);
  }
</style>
