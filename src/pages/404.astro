---
import ButtonLink from '@components/ButtonLink.astro';
import EncabezadoSeccion from '@components/EncabezadoSeccion.astro';
import Base from '@layouts/Base.astro';
---

<Base title="Página no encontrada" description="La página solicitada no existe en orientame.cl.">
  <div class="reading-shell pagina-404">
    <EncabezadoSeccion
      eyebrow="Error 404"
      titulo="No encontramos esta página"
      descripcion="Puede que la dirección esté incompleta o que esta ruta todavía no forme parte de la etapa actual."
    >
      <div class="accion-404"><ButtonLink href="/">Volver al inicio</ButtonLink></div>
    </EncabezadoSeccion>
  </div>
</Base>

<style>
  .pagina-404 {
    padding-block: var(--space-12) var(--space-24);
  }

  /* `ButtonLink` es `inline-flex`: sin un contenedor de bloque queda pegado a la bajada. */
  .accion-404 {
    display: flex;
    margin-top: var(--space-4);
  }
</style>
