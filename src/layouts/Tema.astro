---
import Base from './Base.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import EditorialStatus from '@components/EditorialStatus.astro';
import BloqueSiguientePaso from '@components/BloqueSiguientePaso.astro';
import SourceList from '@components/SourceList.astro';
import Notice from '@components/Notice.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { visibleEnEntorno } from '@/lib/editorial';

interface Props {
  tema: CollectionEntry<'temas'>;
}

const { tema } = Astro.props;
const data = tema.data;

// Se muestra la frase cotidiana real de cada pieza en vez del slug, y se descartan las que
// no se generan en este entorno: un enlace a una pieza no publicada termina en 404.
const sintomas = await getCollection('sintomas');
const sintomasRelacionados = data.sintomasRelacionados.flatMap((slug) => {
  const sintoma = sintomas.find((entrada) => entrada.id === slug);
  return sintoma && visibleEnEntorno(sintoma.data) ? [sintoma] : [];
});

const fechaVerificacion = data.verificadoEl
  ? data.verificadoEl.toISOString().split('T')[0]
  : undefined;

const fuentesFormateadas = data.fuentes.map((f) => ({
  name: `${f.titulo} (${f.organizacion})`,
  url: f.url,
  note: f.notas,
}));
---

<Base title={`${data.titulo} | orientame.cl`} description={data.descripcion}>
  <div class="reading-shell">
    <Breadcrumbs
      items={[
        { label: 'Inicio', href: '/' },
        { label: 'Temas', href: '/temas' },
        { label: data.titulo },
      ]}
    />
  </div>

  <article class="reading-shell articulo-tema">
    <header class="articulo-encabezado">
      <div class="meta-editorial">
        <EditorialStatus
          status={data.estadoEditorial === 'verificado-con-fuentes' ? 'sources' : 'draft'}
          date={fechaVerificacion}
        />
      </div>
      <h1 class="articulo-titulo">{data.titulo}</h1>
      <p class="articulo-bajada">{data.descripcion}</p>
    </header>

    <Notice title="Información orientativa basada en guías oficiales">
      <p>
        Esta página describe un cuadro o concepto clínico a partir de guías y normativas oficiales
        de salud. No busca etiquetar tu experiencia ni sustituye una evaluación médica o
        psicológica.
      </p>
    </Notice>

    <div class="articulo-contenido">
      <slot />
    </div>

    {
      sintomasRelacionados.length > 0 && (
        <section class="seccion-sintomas-relacionados" aria-labelledby="sintomas-rel-titulo">
          <h2 id="sintomas-rel-titulo" class="seccion-titulo">
            Experiencias cotidianas asociadas a este tema
          </h2>
          <p class="seccion-explicacion">
            Muchas personas llegan a este tema buscando frases o vivencias habituales:
          </p>
          <ul class="lista-sintomas">
            {sintomasRelacionados.map((sintoma) => (
              <li>
                <a href={`/siento/${sintoma.id}`} class="enlace-sintoma">
                  {sintoma.data.fraseCotidiana}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <BloqueSiguientePaso
      titulo="¿Cómo consultar por este tema en Chile?"
      descripcion="En la red pública de salud en Chile la puerta de entrada general es el CESFAM o centro de salud familiar donde estás inscrito. Si cuentas con Isapre o seguro, existen vías privadas y centros universitarios."
      accionPrincipal={{
        texto: 'Ver centros y opciones de acceso',
        href: '/donde',
        tipo: 'recorrido',
        aclaracion:
          'Consulta la red de atención primaria, servicios de nivel secundario y alternativas.',
      }}
      pasoMenorCompromiso={{
        texto: 'Guía de costos y coberturas en Chile',
        href: '/primera-vez/cuanto-cuesta',
        descripcion:
          'Qué cuesta cada vía: pública, universitaria y privada, y qué conviene preguntar.',
      }}
    />

    {
      fuentesFormateadas.length > 0 && (
        <footer class="articulo-fuentes">
          <SourceList sources={fuentesFormateadas} />
        </footer>
      )
    }
  </article>
</Base>

<style>
  .articulo-tema {
    margin-block: var(--space-8) var(--space-16);
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .articulo-encabezado {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-line);
  }

  .meta-editorial {
    display: flex;
    align-items: center;
  }

  .articulo-titulo {
    line-height: 1.2;
    color: var(--color-ink-900);
    margin: 0;
  }

  .articulo-bajada {
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--color-ink-600);
    margin: 0;
  }

  .articulo-contenido {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--color-ink-900);
  }

  .articulo-contenido :global(h2) {
    font-size: var(--text-xl);
    line-height: 1.3;
    color: var(--color-ink-900);
    margin-top: var(--space-6);
    margin-bottom: var(--space-2);
  }

  .articulo-contenido :global(h3) {
    font-size: var(--text-lg);
    line-height: 1.4;
    color: var(--color-ink-900);
    margin-top: var(--space-4);
    margin-bottom: var(--space-2);
  }

  .articulo-contenido :global(p) {
    margin: 0 0 var(--space-4);
  }

  .articulo-contenido :global(ul),
  .articulo-contenido :global(ol) {
    margin: 0 0 var(--space-4);
    padding-left: 1.5rem;
  }

  .articulo-contenido :global(li + li) {
    margin-top: var(--space-2);
  }

  .seccion-sintomas-relacionados {
    padding: var(--space-6);
    border-radius: var(--radius-md);
    background: var(--color-mist-50);
    border: 1px solid var(--color-line);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .seccion-titulo {
    font-size: var(--text-xl);
    color: var(--color-ink-900);
    margin: 0;
  }

  .seccion-explicacion {
    font-size: var(--text-sm);
    color: var(--color-ink-600);
    margin: 0;
    line-height: 1.5;
  }

  .lista-sintomas {
    margin: var(--space-2) 0 0;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .enlace-sintoma {
    font-weight: 600;
    color: var(--color-green-900);
  }

  .articulo-fuentes {
    margin-top: var(--space-4);
  }
</style>
