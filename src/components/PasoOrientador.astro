---
import { hrefDeDestino, RUTA_URGENCIA, type Paso } from '@/lib/orientador';
import Icon from './Icon.astro';

interface Props {
  paso: Paso;
  /** Encabezado del documento: sólo la primera pregunta de la página usa `h1`. */
  nivel?: 'h1' | 'h2';
}

const { paso, nivel = 'h1' } = Astro.props;
const Encabezado = nivel;
---

<div class="paso">
  <Encabezado class="paso-pregunta">{paso.pregunta}</Encabezado>
  {paso.ayuda && <p class="paso-ayuda">{paso.ayuda}</p>}

  <ul class="paso-opciones">
    {
      paso.opciones.map((opcion) => {
        const href = hrefDeDestino(opcion.destino);
        const esUrgencia = href === RUTA_URGENCIA;

        return (
          <li>
            <a href={href} class:list={['opcion', { urgente: esUrgencia }]}>
              <span class="opcion-texto">
                <span class="opcion-etiqueta">{opcion.etiqueta}</span>
                {opcion.detalle && <span class="opcion-detalle">{opcion.detalle}</span>}
              </span>
              <Icon name={esUrgencia ? 'alerta' : 'chevron-derecha'} size={20} />
            </a>
          </li>
        );
      })
    }
  </ul>
</div>

<style>
  .paso-pregunta {
    font-size: var(--text-xl);
  }

  .paso-ayuda {
    max-width: 38rem;
    margin-top: var(--space-4);
    color: var(--color-ink-600);
  }

  .paso-opciones {
    display: grid;
    gap: var(--space-3);
    padding: 0;
    margin-top: var(--space-8);
    list-style: none;
  }

  .opcion {
    display: flex;
    min-height: 3.5rem;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-6);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-white);
    color: var(--color-ink-900);
    text-decoration: none;
  }

  .opcion:hover {
    border-color: var(--color-green-700);
    background: var(--color-mist-50);
    color: var(--color-ink-900);
  }

  .opcion :global(svg) {
    color: var(--color-sage-400);
  }

  .opcion:hover :global(svg) {
    color: var(--color-green-700);
  }

  .opcion-texto {
    display: grid;
    gap: var(--space-1);
  }

  .opcion-etiqueta {
    font-size: var(--text-base);
    font-weight: 600;
    line-height: 1.35;
  }

  .opcion-detalle {
    color: var(--color-ink-600);
    font-size: var(--text-sm);
    line-height: 1.45;
  }

  .opcion.urgente {
    border-color: color-mix(in srgb, var(--color-urgent-700) 40%, var(--color-line));
    background: var(--color-urgent-50);
  }

  .opcion.urgente .opcion-etiqueta,
  .opcion.urgente :global(svg) {
    color: var(--color-urgent-700);
  }

  .opcion.urgente:hover {
    border-color: var(--color-urgent-700);
    background: var(--color-urgent-50);
  }

  .opcion.urgente:hover :global(svg) {
    color: var(--color-urgent-700);
  }

  @media (prefers-reduced-motion: no-preference) {
    .opcion,
    .opcion :global(svg) {
      transition:
        border-color 150ms ease,
        background-color 150ms ease,
        color 150ms ease;
    }
  }
</style>
