---
import { hrefDeDestino, RUTA_URGENCIA, type Paso } from '@/lib/orientador';
import Icon from './Icon.astro';

interface Props {
  paso: Paso;
  /** Encabezado del documento: sólo la primera pregunta de la página usa `h1`. */
  nivel?: 'h1' | 'h2';
  /**
   * Oculta el detalle de cada opción. La portada muestra las ocho puertas de entrada en la
   * primera pantalla, y con el detalle de cada una la lista deja de caber en un móvil.
   * En `/empezar` el detalle sí se muestra, porque ahí la pregunta es toda la página.
   */
  compacto?: boolean;
}

const { paso, nivel = 'h1', compacto = false } = Astro.props;

// Cuando el paso trae título propio, la página primero nombra lo que la persona eligió y
// la pregunta baja un nivel. `inicio` no tiene título: ahí la pregunta es el encabezado.
const Encabezado = nivel;
const NivelPregunta = paso.titulo ? (nivel === 'h1' ? 'h2' : 'h3') : nivel;
---

<div class="paso">
  {paso.titulo && <Encabezado class="paso-titulo">{paso.titulo}</Encabezado>}

  {
    paso.entrada && (
      <div class="paso-entrada">
        {paso.entrada.map((parrafo) => (
          <p>{parrafo}</p>
        ))}
      </div>
    )
  }

  <NivelPregunta class="paso-pregunta">{paso.pregunta}</NivelPregunta>
  {paso.ayuda && <p class="paso-ayuda">{paso.ayuda}</p>}

  <ul class="opciones-lista paso-opciones">
    {
      paso.opciones.map((opcion) => {
        const href = hrefDeDestino(opcion.destino);
        const esUrgencia = href === RUTA_URGENCIA;

        return (
          <li>
            <a href={href} class:list={['opcion', { urgente: esUrgencia }]}>
              <span class="opcion-texto">
                <span class="opcion-etiqueta">{opcion.etiqueta}</span>
                {opcion.detalle && !compacto && (
                  <span class="opcion-detalle">{opcion.detalle}</span>
                )}
              </span>
              <Icon name={esUrgencia ? 'alerta' : 'chevron-derecha'} size={20} />
            </a>
          </li>
        );
      })
    }
  </ul>
</div>

<style>
  .paso-titulo {
    font-size: var(--text-2xl);
    line-height: 1.2;
  }

  /* Reconocimiento del paso intermedio: se lee antes de la siguiente pregunta y por eso
     va con el mismo cuerpo que el texto de lectura de una guía. */
  .paso-entrada {
    max-width: 40rem;
    margin-top: var(--space-6);
    font-size: var(--text-lg);
    line-height: 1.6;
  }

  .paso-entrada p + p {
    margin-top: var(--space-4);
  }

  .paso-pregunta {
    font-size: var(--text-xl);
  }

  .paso-entrada + .paso-pregunta {
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-line);
  }

  .paso-ayuda {
    max-width: 38rem;
    margin-top: var(--space-4);
    color: var(--color-ink-600);
  }

  /* Las tarjetas de opción viven en `global.css`: las comparte `GuiaOrientador`. */
  .paso-opciones {
    margin-top: var(--space-8);
  }

  @media (max-width: 48rem) {
    .paso-entrada {
      font-size: var(--text-base);
    }

    .paso-entrada + .paso-pregunta {
      margin-top: var(--space-8);
      padding-top: var(--space-6);
    }
  }
</style>
