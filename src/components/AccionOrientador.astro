---
// Algo que la persona puede hacer sin salir de la página: copiar un mensaje o llamar a
// una línea oficial. Los hechos verificados sobre el sistema de salud ya no pasan por
// aquí (`DatoOrientador.astro`): mezclarlos hacía que el bloque "qué puedes hacer"
// partiera por un trámite en vez de por una acción.

import type { Accion } from '@/lib/orientador';
import FuentesLinea from './FuentesLinea.astro';
import GuionCopiable from './GuionCopiable.astro';
import Icon from './Icon.astro';

interface Props {
  accion: Accion;
}

const { accion } = Astro.props;
---

{
  accion.tipo === 'guion' ? (
    <GuionCopiable titulo={accion.titulo} texto={accion.texto} destino={accion.destino} />
  ) : (
    <div class="accion llamada">
      <p class="accion-titulo">
        <Icon name="telefono" size={18} />
        <span>{accion.titulo}</span>
      </p>
      <p class="accion-descripcion">{accion.descripcion}</p>
      <a class="accion-llamar" href={`tel:${accion.marcar}`} data-siguiente-paso="llamada">
        Llamar al {accion.numero}
      </a>
      <FuentesLinea fuenteIds={accion.fuenteIds} />
    </div>
  )
}

<style>
  .accion {
    padding: var(--space-6);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-white);
  }

  .accion-titulo {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-green-900);
    font-size: var(--text-base);
    font-weight: 700;
    line-height: 1.35;
  }

  .accion-descripcion {
    margin-top: var(--space-3);
    color: var(--color-ink-600);
  }

  .accion-llamar {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    padding: var(--space-3) var(--space-6);
    margin-top: var(--space-4);
    border: 2px solid var(--color-green-900);
    border-radius: var(--radius-sm);
    color: var(--color-white);
    background: var(--color-green-900);
    font-size: var(--text-base);
    font-weight: 700;
    text-decoration: none;
  }

  .accion-llamar:hover {
    border-color: var(--color-green-700);
    background: var(--color-green-700);
    color: var(--color-white);
  }

  @media (prefers-reduced-motion: no-preference) {
    .accion-llamar {
      transition:
        background-color 150ms ease,
        border-color 150ms ease;
    }
  }
</style>
