---
import Icon from './Icon.astro';

interface Props {
  title: string;
  href?: string;
  tone?: 'default' | 'soft';
}

const { title, href, tone = 'default' } = Astro.props;
---

<article class:list={['card', tone, { enlazada: href }]}>
  <h3>
    {href ? <a href={href}>{title}</a> : title}
    {
      href && (
        <span class="indicador" aria-hidden="true">
          <Icon name="flecha-derecha" size={18} />
        </span>
      )
    }
  </h3>
  <div class="card-body"><slot /></div>
</article>

<style>
  .card {
    position: relative;
    padding: var(--space-6);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-white);
  }

  .card.soft {
    background: var(--color-mist-50);
  }

  /* Una tarjeta enlazada tiene que verse enlazada: sin este indicador se leía como un
     recuadro de texto y nada anunciaba que llevaba a otra página. */
  h3 {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: var(--space-4);
  }

  h3 a {
    color: var(--color-green-900);
    text-decoration: none;
  }

  h3 a::after {
    position: absolute;
    content: '';
    inset: 0;
    border-radius: var(--radius-md);
  }

  h3 a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .indicador {
    display: inline-flex;
    width: 1.875rem;
    height: 1.875rem;
    flex: none;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    color: var(--color-green-700);
    background: var(--color-mist-100);
  }

  .card.enlazada:hover {
    border-color: var(--color-sage-400);
    transform: translateY(-1px);
  }

  .card.enlazada:hover .indicador {
    color: var(--color-white);
    background: var(--color-green-700);
    transform: translateX(0.125rem);
  }

  /* El enlace cubre toda la tarjeta, así que el foco se dibuja sobre la tarjeta entera.
     Bajo `@supports` para no quedarnos sin indicador de foco si `:has()` no está. */
  @supports selector(:has(a)) {
    .card:has(h3 a:focus-visible) {
      border-radius: var(--radius-md);
      box-shadow: var(--focus-ring);
    }

    .card h3 a:focus-visible {
      box-shadow: none;
    }
  }

  .card-body {
    margin-top: var(--space-3);
    color: var(--color-ink-600);
  }

  @media (prefers-reduced-motion: no-preference) {
    .card,
    .indicador {
      transition:
        border-color 150ms ease,
        background-color 150ms ease,
        color 150ms ease,
        transform 150ms ease;
    }
  }
</style>
