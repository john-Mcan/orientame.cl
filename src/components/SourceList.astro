---
interface Source {
  name: string;
  url: string;
  note?: string;
}

interface Props {
  sources: Source[];
}

const { sources } = Astro.props;
---

<section class="sources" aria-labelledby="fuentes-titulo">
  <h2 id="fuentes-titulo">Fuentes oficiales</h2>
  <ul>
    {
      sources.map((source) => (
        <li>
          <a href={source.url} rel="external noopener noreferrer" referrerpolicy="no-referrer">
            {source.name}
            <span class="sr-only"> (abre un sitio externo)</span>
          </a>
          {source.note && <span> — {source.note}</span>}
        </li>
      ))
    }
  </ul>
</section>

<style>
  .sources {
    padding: var(--space-6);
    border-radius: var(--radius-md);
    background: var(--color-mist-50);
  }

  h2 {
    font-size: var(--text-lg);
  }

  ul {
    margin-top: var(--space-4);
    padding-left: 1.25rem;
  }

  li + li {
    margin-top: var(--space-3);
  }

  li {
    color: var(--color-ink-600);
    font-size: var(--text-sm);
  }
</style>
