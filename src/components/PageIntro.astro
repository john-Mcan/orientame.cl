---
interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  wide?: boolean;
}

const { eyebrow, title, description, wide = false } = Astro.props;
---

<header class:list={['page-intro', wide ? 'page-shell' : 'reading-shell']}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1>{title}</h1>
  <p class="lede">{description}</p>
  <slot />
</header>

<style>
  .page-intro {
    padding-block: clamp(var(--space-12), 8vw, var(--space-24));
  }

  .page-intro > * + * {
    margin-top: var(--space-6);
  }

  .page-intro .eyebrow + h1 {
    margin-top: var(--space-3);
  }
</style>
