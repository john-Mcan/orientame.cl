---
import Icon from './Icon.astro';

interface Item {
  label: string;
  href?: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<nav class="breadcrumbs" aria-label="Migas de pan">
  <ol>
    {
      items.map((item, index) => (
        <li>
          {item.href ? (
            <a href={item.href}>{item.label}</a>
          ) : (
            <span aria-current="page">{item.label}</span>
          )}
          {index < items.length - 1 && (
            <span class="separator">
              <Icon name="chevron-derecha" size={16} />
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .breadcrumbs {
    padding-top: var(--space-6);
  }

  ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    margin: 0;
    color: var(--color-ink-600);
    font-size: var(--text-sm);
    list-style: none;
  }

  li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  /* Amplía el área táctil de los enlaces sin engrosar visualmente la fila. */
  li a,
  li span[aria-current] {
    display: inline-flex;
    align-items: center;
    padding-block: var(--space-2);
  }

  .separator {
    display: inline-flex;
    color: var(--color-sage-400);
  }
</style>
