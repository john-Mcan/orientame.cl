---
import { hrefDeDestino, rutaDe, RUTA_BASE, RUTA_URGENCIA, type Resultado } from '@/lib/orientador';
import AccionOrientador from './AccionOrientador.astro';
import EditorialStatus from './EditorialStatus.astro';
import Icon from './Icon.astro';

interface Props {
  resultado: Resultado;
  /** Pregunta del paso anterior, para nombrar el enlace de retorno. */
  preguntaAnterior?: string;
}

const { resultado, preguntaAnterior } = Astro.props;
const rutaAnterior = rutaDe(resultado.padre);
---

<article class="resultado">
  <p class="eyebrow">Tu siguiente paso</p>
  <h1>{resultado.titulo}</h1>

  <div class="resultado-cuerpo">
    {resultado.cuerpo.map((parrafo) => <p>{parrafo}</p>)}
  </div>

  {
    resultado.avisoUrgencia && (
      <aside class="aviso-urgencia">
        <p class="aviso-texto">
          <Icon name="alerta" size={20} />
          <span>{resultado.avisoUrgencia}</span>
        </p>
        <a class="aviso-enlace" href={RUTA_URGENCIA}>
          Ver ayuda inmediata
          <Icon name="flecha-derecha" size={18} />
        </a>
      </aside>
    )
  }

  <section class="acciones" aria-labelledby="acciones-titulo">
    <h2 id="acciones-titulo">Lo que puedes hacer ahora</h2>
    <ul class="linea-orientacion">
      {
        resultado.acciones.map((accion) => (
          <li>
            <AccionOrientador accion={accion} />
          </li>
        ))
      }
    </ul>
  </section>

  <section class="menor-compromiso" aria-labelledby="menor-compromiso-titulo">
    <h2 id="menor-compromiso-titulo">Si nada de esto se siente posible hoy</h2>
    <p>{resultado.menorCompromiso.texto}</p>
    {
      resultado.menorCompromiso.enlace && (
        <p class="menor-compromiso-enlace">
          <a
            href={hrefDeDestino(resultado.menorCompromiso.enlace.destino)}
            data-siguiente-paso="recorrido"
          >
            {resultado.menorCompromiso.enlace.etiqueta}
            <Icon name="flecha-derecha" size={18} />
          </a>
        </p>
      )
    }
  </section>

  <nav class="resultado-nav" aria-label="Navegación del orientador">
    <a href={rutaAnterior} class="nav-volver">
      <Icon name="flecha-izquierda" size={18} />
      <span>{preguntaAnterior ? `Volver a: ${preguntaAnterior}` : 'Volver al paso anterior'}</span>
    </a>
    <a href={RUTA_BASE} class="nav-reiniciar">Empezar de nuevo</a>
  </nav>

  {/* `EditorialStatus` renderiza un `<p>`, así que el contenedor no puede ser otro `<p>`. */}
  <div class="resultado-verificacion">
    <EditorialStatus status="sources" />
    <p>
      Las afirmaciones sobre el sistema de salud citan su fuente oficial junto al dato. Esta página
      no evalúa tu situación ni registra lo que elegiste.
    </p>
  </div>
</article>

<style>
  .resultado > * + * {
    margin-top: var(--space-6);
  }

  .eyebrow + h1 {
    margin-top: var(--space-3);
  }

  .resultado-cuerpo {
    max-width: 40rem;
    font-size: var(--text-lg);
    line-height: 1.6;
  }

  .resultado-cuerpo p + p {
    margin-top: var(--space-4);
  }

  /* Aviso de urgencia dentro de un resultado */

  .aviso-urgencia {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-6);
    border: 1px solid color-mix(in srgb, var(--color-urgent-700) 40%, var(--color-line));
    border-radius: var(--radius-md);
    background: var(--color-urgent-50);
  }

  .aviso-texto {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-urgent-700);
    font-weight: 600;
  }

  .aviso-enlace {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: var(--space-2);
    padding-inline: var(--space-3);
    color: var(--color-urgent-700);
    font-weight: 700;
    white-space: nowrap;
  }

  /* Acciones */

  .acciones {
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-line);
  }

  .acciones h2,
  .menor-compromiso h2 {
    font-size: var(--text-lg);
  }

  .acciones .linea-orientacion {
    margin-top: var(--space-6);
  }

  /* Menor compromiso */

  .menor-compromiso {
    padding: var(--space-6);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: var(--color-mist-50);
  }

  .menor-compromiso p {
    margin-top: var(--space-3);
    color: var(--color-ink-600);
  }

  .menor-compromiso-enlace a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 600;
  }

  /* Navegación */

  .resultado-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-line);
  }

  .resultado-nav a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .nav-volver span {
    text-align: left;
  }

  .nav-reiniciar {
    margin-left: auto;
  }

  /* Verificación */

  .resultado-verificacion {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
  }

  .resultado-verificacion p {
    color: var(--color-ink-600);
    font-size: var(--text-sm);
  }

  @media (max-width: 34rem) {
    .aviso-urgencia {
      flex-direction: column;
      align-items: flex-start;
    }

    .resultado-nav {
      flex-direction: column;
    }

    .nav-reiniciar {
      margin-left: 0;
    }
  }
</style>
