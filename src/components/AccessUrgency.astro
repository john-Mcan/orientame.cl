---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<a class:list={['urgency-link', { compact }]} href="/urgencia">
  <svg aria-hidden="true" viewBox="0 0 20 20" width="20" height="20">
    <path
      d="M10 2.5v9m0 3.25v.75"
      fill="none"
      stroke="currentColor"
      stroke-linecap="round"
      stroke-width="2.25"></path>
    <circle cx="10" cy="10" r="8" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
  </svg>
  <span>{compact ? 'Ayuda ahora' : '¿Necesitas ayuda ahora?'}</span>
</a>

<style>
  .urgency-link {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border: 1px solid color-mix(in srgb, var(--color-urgent-700) 45%, transparent);
    border-radius: var(--radius-sm);
    color: var(--color-urgent-700);
    background: var(--color-urgent-50);
    font-size: var(--text-sm);
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
  }

  .urgency-link:hover {
    border-color: var(--color-urgent-700);
    color: var(--color-urgent-700);
  }

  .urgency-link.compact {
    padding-inline: var(--space-2);
  }

  svg {
    flex: none;
  }
</style>
