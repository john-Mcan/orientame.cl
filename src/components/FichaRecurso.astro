---
import type { Recurso } from '@/lib/resources';
import SelloRevision from './SelloRevision.astro';

interface Props {
  recurso: Recurso;
}

const { recurso } = Astro.props;

const tipoEtiquetas: Record<string, string> = {
  cesfam: 'CESFAM · Atención primaria',
  cecosf: 'CECOSF · Centro comunitario',
  cosam: 'COSAM · Nivel secundario',
  hospital: 'Hospital',
  'clinica-universitaria': 'Clínica universitaria',
  ong: 'Organización comunitaria / ONG',
  linea: 'Línea de orientación / crisis',
  otro: 'Servicio de salud',
};

const costoEtiquetas: Record<string, string> = {
  gratuito: 'Gratuito',
  'segun-tramo': 'Según tramo Fonasa',
  bajo: 'Bajo costo / arancel diferenciado',
  variable: 'Arancel variable',
  desconocido: 'Costo a confirmar',
};

const modalidadEtiquetas: Record<string, string> = {
  presencial: 'Atención presencial',
  remoto: 'Atención remota / telefónica',
  hibrido: 'Atención presencial y remota',
};
---

<article
  class="ficha-recurso"
  id={recurso.id}
  aria-labelledby={`titulo-${recurso.id}`}
  data-recurso
  data-comuna={recurso.comunaSlug ?? 'nacional'}
  data-tipo={recurso.tipo}
  data-costo={recurso.costo}
  data-modalidad={recurso.modalidad}
>
  <header class="ficha-encabezado">
    <div class="ficha-meta">
      <span class="badge badge-tipo">{tipoEtiquetas[recurso.tipo] ?? recurso.tipo}</span>
      <span class="badge badge-costo">{costoEtiquetas[recurso.costo]}</span>
      <span class="badge badge-modalidad">{modalidadEtiquetas[recurso.modalidad]}</span>
    </div>
    <h3 id={`titulo-${recurso.id}`} class="ficha-titulo">{recurso.nombre}</h3>
    <div class="ficha-sello">
      <SelloRevision nivel={recurso.nivel} estado={recurso.estado} fecha={recurso.verificadoEl} />
    </div>
  </header>

  <div class="ficha-cuerpo">
    <dl class="ficha-datos">
      {
        recurso.direccion && (
          <div class="dato-fila">
            <dt class="dato-termino">Ubicación</dt>
            <dd class="dato-valor">
              {recurso.direccion}
              {recurso.comuna && <span> ({recurso.comuna})</span>}
            </dd>
          </div>
        )
      }

      {
        recurso.telefono && (
          <div class="dato-fila">
            <dt class="dato-termino">Teléfono</dt>
            <dd class="dato-valor">
              <a
                href={`tel:${recurso.telefonoMarcar ?? recurso.telefono.replace(/\s+/g, '')}`}
                class="enlace-telefono"
                data-siguiente-paso="llamada"
              >
                {recurso.telefono}
              </a>
            </dd>
          </div>
        )
      }

      {
        recurso.web && (
          <div class="dato-fila">
            <dt class="dato-termino">Sitio web oficial</dt>
            <dd class="dato-valor">
              <a href={recurso.web} rel="external noopener noreferrer" referrerpolicy="no-referrer">
                Abrir sitio oficial
                <span class="sr-only"> (enlace externo)</span>
              </a>
            </dd>
          </div>
        )
      }

      {
        recurso.rangoPrecio && (
          <div class="dato-fila">
            <dt class="dato-termino">Detalle de costo</dt>
            <dd class="dato-valor">{recurso.rangoPrecio}</dd>
          </div>
        )
      }

      {
        recurso.horarios && (
          <div class="dato-fila">
            <dt class="dato-termino">Horarios de atención</dt>
            <dd class="dato-valor">{recurso.horarios}</dd>
          </div>
        )
      }
    </dl>

    {
      recurso.requisitos.length > 0 && (
        <section class="ficha-seccion" aria-labelledby={`requisitos-${recurso.id}`}>
          <h4 id={`requisitos-${recurso.id}`} class="seccion-subtitulo">
            Requisitos de acceso
          </h4>
          <ul class="lista-requisitos">
            {recurso.requisitos.map((req) => (
              <li>{req}</li>
            ))}
          </ul>
        </section>
      )
    }

    {
      recurso.pasosAcceso.length > 0 && (
        <section class="ficha-seccion" aria-labelledby={`pasos-${recurso.id}`}>
          <h4 id={`pasos-${recurso.id}`} class="seccion-subtitulo">
            {recurso.nivel === 'B'
              ? 'Cómo solicitar atención en este centro'
              : 'Orientación de acceso'}
          </h4>
          <ol class="lista-pasos">
            {recurso.pasosAcceso.map((paso) => (
              <li>{paso}</li>
            ))}
          </ol>
        </section>
      )
    }

    {
      recurso.notas && (
        <div class="ficha-nota">
          <p>{recurso.notas}</p>
        </div>
      )
    }
  </div>

  <footer class="ficha-pie">
    <p class="fuente-nota">
      <span>Fuente: </span>
      {
        recurso.fuente.url ? (
          <a
            href={recurso.fuente.url}
            rel="external noopener noreferrer"
            referrerpolicy="no-referrer"
          >
            {recurso.fuente.nombre}
          </a>
        ) : (
          <span>{recurso.fuente.nombre}</span>
        )
      }
      {recurso.fuente.consultadoEl && <span> (consultado el {recurso.fuente.consultadoEl})</span>}
    </p>
  </footer>
</article>

<style>
  .ficha-recurso {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-white);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .ficha-encabezado {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .ficha-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .badge {
    display: inline-block;
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .badge-tipo {
    background: var(--color-mist-100);
    color: var(--color-green-900);
  }

  .badge-costo {
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    color: var(--color-ink-900);
  }

  .badge-modalidad {
    background: var(--color-mist-50);
    color: var(--color-ink-600);
    border: 1px solid var(--color-line);
  }

  .ficha-titulo {
    font-size: var(--text-xl);
    line-height: 1.3;
    color: var(--color-ink-900);
    margin: 0;
  }

  .ficha-sello {
    margin-top: var(--space-1);
  }

  .ficha-cuerpo {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .ficha-datos {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    font-size: var(--text-sm);
  }

  .dato-fila {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: var(--space-3);
  }

  @media (max-width: 36rem) {
    .dato-fila {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }

  .dato-termino {
    font-weight: 700;
    color: var(--color-ink-600);
  }

  .dato-valor {
    margin: 0;
    color: var(--color-ink-900);
  }

  .enlace-telefono {
    font-weight: 700;
    color: var(--color-green-900);
  }

  .ficha-seccion {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .seccion-subtitulo {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-ink-900);
    margin: 0;
  }

  .lista-requisitos {
    margin: 0;
    padding-left: 1.25rem;
    font-size: var(--text-sm);
    color: var(--color-ink-600);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .lista-pasos {
    margin: 0;
    padding-left: 1.25rem;
    font-size: var(--text-sm);
    color: var(--color-ink-900);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    line-height: 1.5;
  }

  .ficha-nota {
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
    background: var(--color-mist-50);
    font-size: var(--text-xs);
    color: var(--color-ink-600);
    line-height: 1.5;
  }

  .ficha-nota p {
    margin: 0;
  }

  .ficha-pie {
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-line);
  }

  .fuente-nota {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--color-ink-600);
  }
</style>
