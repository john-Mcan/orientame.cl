---
import { textoBusqueda, type Recurso } from '@/lib/resources';
import SelloRevision from './SelloRevision.astro';

interface Props {
  recurso: Recurso;
}

const { recurso } = Astro.props;

const tipoEtiquetas: Record<string, string> = {
  cesfam: 'CESFAM · Atención primaria',
  cecosf: 'CECOSF · Centro comunitario',
  cosam: 'COSAM · Nivel secundario',
  hospital: 'Hospital',
  'clinica-universitaria': 'Clínica universitaria',
  ong: 'Organización comunitaria / ONG',
  linea: 'Línea de orientación / crisis',
  otro: 'Servicio de salud',
};

const costoEtiquetas: Record<string, string> = {
  gratuito: 'Gratuito',
  'segun-tramo': 'Según tramo Fonasa',
  bajo: 'Bajo costo / arancel diferenciado',
  variable: 'Arancel variable',
  desconocido: 'Costo a confirmar',
};

const modalidadEtiquetas: Record<string, string> = {
  presencial: 'Atención presencial',
  remoto: 'Atención remota / telefónica',
  hibrido: 'Atención presencial y remota',
};
---

<article
  class="ficha-recurso"
  id={recurso.id}
  aria-labelledby={`titulo-${recurso.id}`}
  data-recurso
  data-comuna={recurso.comunaSlug ?? 'nacional'}
  data-tipo={recurso.tipo}
  data-costo={recurso.costo}
  data-modalidad={recurso.modalidad}
  data-busqueda={textoBusqueda(recurso)}
>
  {
    /* Lo que se ve sin abrir nada es lo que sirve para decidir si este centro te sirve y para
      llegar a él: qué es, dónde queda y a qué número llamar. El resto —requisitos, horarios,
      pasos, fuente— vive en el desplegable. Antes la ficha mostraba todo y medía 1.100 px en
      móvil: treinta y una fichas hacían una página de 23.000 px, y el objetivo es cubrir el
      país entero. */
  }
  <header class="ficha-encabezado">
    <p class="ficha-meta">
      <span class="ficha-tipo">{tipoEtiquetas[recurso.tipo] ?? recurso.tipo}</span>
      {recurso.comuna && <span>{recurso.comuna}</span>}
      <span>{costoEtiquetas[recurso.costo]}</span>
    </p>
    <h3 id={`titulo-${recurso.id}`} class="ficha-titulo">{recurso.nombre}</h3>
  </header>

  <div class="ficha-resumen">
    {recurso.direccion && <p class="ficha-direccion">{recurso.direccion}</p>}
    {
      recurso.telefono && (
        <p>
          <a
            href={`tel:${recurso.telefonoMarcar ?? recurso.telefono.replace(/\s+/g, '')}`}
            class="enlace-telefono"
            data-siguiente-paso="llamada"
          >
            Llamar al {recurso.telefono}
          </a>
        </p>
      )
    }
  </div>

  <details class="ficha-detalle">
    <summary>
      <span>Requisitos, horarios y fuente</span>
    </summary>

    <div class="ficha-cuerpo">
      <div class="ficha-sello">
        <SelloRevision nivel={recurso.nivel} estado={recurso.estado} fecha={recurso.verificadoEl} />
      </div>

      <dl class="ficha-datos">
        <div class="dato-fila">
          <dt class="dato-termino">Modalidad</dt>
          <dd class="dato-valor">{modalidadEtiquetas[recurso.modalidad]}</dd>
        </div>

        {
          recurso.web && (
            <div class="dato-fila">
              <dt class="dato-termino">Sitio web oficial</dt>
              <dd class="dato-valor">
                <a
                  href={recurso.web}
                  rel="external noopener noreferrer"
                  referrerpolicy="no-referrer"
                >
                  Abrir sitio oficial
                  <span class="sr-only"> (enlace externo)</span>
                </a>
              </dd>
            </div>
          )
        }

        {
          recurso.rangoPrecio && (
            <div class="dato-fila">
              <dt class="dato-termino">Detalle de costo</dt>
              <dd class="dato-valor">{recurso.rangoPrecio}</dd>
            </div>
          )
        }

        {
          recurso.horarios && (
            <div class="dato-fila">
              <dt class="dato-termino">Horarios de atención</dt>
              <dd class="dato-valor">{recurso.horarios}</dd>
            </div>
          )
        }
      </dl>

      {
        recurso.requisitos.length > 0 && (
          <section class="ficha-seccion" aria-labelledby={`requisitos-${recurso.id}`}>
            <h4 id={`requisitos-${recurso.id}`} class="seccion-subtitulo">
              Requisitos de acceso
            </h4>
            <ul class="lista-requisitos">
              {recurso.requisitos.map((req) => (
                <li>{req}</li>
              ))}
            </ul>
          </section>
        )
      }

      {
        recurso.pasosAcceso.length > 0 && (
          <section class="ficha-seccion" aria-labelledby={`pasos-${recurso.id}`}>
            <h4 id={`pasos-${recurso.id}`} class="seccion-subtitulo">
              {recurso.nivel === 'B'
                ? 'Cómo solicitar atención en este centro'
                : 'Orientación de acceso'}
            </h4>
            <ol class="lista-pasos">
              {recurso.pasosAcceso.map((paso) => (
                <li>{paso}</li>
              ))}
            </ol>
          </section>
        )
      }

      {
        recurso.notas && (
          <div class="ficha-nota">
            <p>{recurso.notas}</p>
          </div>
        )
      }
    </div>

    <footer class="ficha-pie">
      <p class="fuente-nota">
        <span>Fuente: </span>
        {
          recurso.fuente.url ? (
            <a
              href={recurso.fuente.url}
              rel="external noopener noreferrer"
              referrerpolicy="no-referrer"
            >
              {recurso.fuente.nombre}
            </a>
          ) : (
            <span>{recurso.fuente.nombre}</span>
          )
        }
        {recurso.fuente.consultadoEl && <span> (consultado el {recurso.fuente.consultadoEl})</span>}
      </p>
    </footer>
  </details>
</article>

<style>
  .ficha-recurso {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-white);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .ficha-encabezado {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  /* Tipo, comuna y costo en una línea y no en tres etiquetas apiladas: apiladas ocupaban tres
     renglones en móvil y se leían antes que el nombre del centro.
     Sin separadores dibujados con `::before`: al envolver, el punto caía al principio del
     renglón siguiente y parecía una viñeta rota. Separan el espacio y el color. */
  .ficha-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    color: var(--color-ink-600);
    font-size: var(--text-sm);
  }

  .ficha-tipo {
    color: var(--color-green-700);
    font-weight: 700;
  }

  .ficha-titulo {
    font-size: var(--text-lg);
    line-height: 1.3;
    color: var(--color-ink-900);
    margin: 0;
  }

  .ficha-resumen {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--text-sm);
  }

  .ficha-direccion {
    color: var(--color-ink-600);
  }

  .ficha-detalle > summary {
    display: flex;
    min-height: 2.75rem;
    align-items: center;
    color: var(--color-green-900);
    font-size: var(--text-sm);
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }

  .ficha-detalle > summary::-webkit-details-marker {
    display: none;
  }

  .ficha-detalle > summary span::before {
    display: inline-block;
    width: 1rem;
    color: var(--color-sage-400);
    content: '▸';
  }

  .ficha-detalle[open] > summary span::before {
    content: '▾';
  }

  .ficha-sello {
    margin-bottom: var(--space-4);
  }

  .ficha-cuerpo {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .ficha-datos {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    font-size: var(--text-sm);
  }

  .dato-fila {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: var(--space-3);
  }

  @media (max-width: 36rem) {
    .dato-fila {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }

  .dato-termino {
    font-weight: 700;
    color: var(--color-ink-600);
  }

  .dato-valor {
    margin: 0;
    color: var(--color-ink-900);
  }

  .enlace-telefono {
    font-weight: 700;
    color: var(--color-green-900);
  }

  .ficha-seccion {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .seccion-subtitulo {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-ink-900);
    margin: 0;
  }

  .lista-requisitos {
    margin: 0;
    padding-left: 1.25rem;
    font-size: var(--text-sm);
    color: var(--color-ink-600);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .lista-pasos {
    margin: 0;
    padding-left: 1.25rem;
    font-size: var(--text-sm);
    color: var(--color-ink-900);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    line-height: 1.5;
  }

  .ficha-nota {
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
    background: var(--color-mist-50);
    font-size: var(--text-xs);
    color: var(--color-ink-600);
    line-height: 1.5;
  }

  .ficha-nota p {
    margin: 0;
  }

  .ficha-pie {
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-line);
  }

  .fuente-nota {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--color-ink-600);
  }
</style>
