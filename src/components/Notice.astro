---
interface Props {
  title: string;
  tone?: 'info' | 'urgent';
}

const { title, tone = 'info' } = Astro.props;
---

<aside class:list={['notice', tone]}>
  <h2>{title}</h2>
  <div class="notice-body"><slot /></div>
</aside>

<style>
  .notice {
    padding: var(--space-6);
    border: 1px solid var(--color-sage-400);
    border-left: 0.35rem solid var(--color-green-900);
    border-radius: var(--radius-md);
    background: var(--color-mist-50);
  }

  .notice.urgent {
    border-color: color-mix(in srgb, var(--color-urgent-700) 55%, var(--color-line));
    border-left-color: var(--color-urgent-700);
    background: var(--color-urgent-50);
  }

  h2 {
    font-size: var(--text-lg);
  }

  .notice-body {
    margin-top: var(--space-3);
  }
</style>
